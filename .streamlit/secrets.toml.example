# Plantilla de secrets — cópiala a `.streamlit/secrets.toml` (local, gitignored)
# o pégala en Streamlit Community Cloud → Settings → Secrets, con valores reales.

[gcp_service_account]
type = "service_account"
project_id = "<tu-project-id>"
private_key_id = "<private_key_id>"
private_key = "-----BEGIN PRIVATE KEY-----\n<contenido-de-la-llave>\n-----END PRIVATE KEY-----\n"
client_email = "<cuenta>@<project>.iam.gserviceaccount.com"
client_id = "<client_id>"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "<client_x509_cert_url>"
universe_domain = "googleapis.com"

[drive]
# ID de la carpeta de Drive compartida con la cuenta de servicio (client_email).
folder_id = "<id-de-la-carpeta-de-drive>"

[auth]
# Credenciales del gate de acceso de la app.
username = "<usuario>"
password = "<contraseña>"
